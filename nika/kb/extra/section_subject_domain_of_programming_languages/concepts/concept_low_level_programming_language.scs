concept_low_level_programming_language
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [язык программирования низкого уровня]
    (* <- lang_ru;; *);
    [low-level programming language]
    (* <- lang_en;; *);
=> nrel_note:
    [Язык программирования низкого уровня — язык, конструкции которого непосредственно соответствуют командам процессора и особенностям его архитектуры.]
    (* <- lang_ru;; *);
=> nrel_explanation:
    [Языки низкого уровня применяются там, где нужен полный контроль над аппаратурой: в драйверах, загрузчиках, встраиваемых системах и критичных по скорости фрагментах кода.]
    (* <- lang_ru;; *);
