            (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Язык программирования со статической типизацией — язык программирования, в котором проверка типов выполняется до выполнения программы.]
                    (* <- lang_ru;; *);;
            *);;
