concept_standard_library
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [стандартная библиотека]
    (* <- lang_ru;; *);
    [standard library]
    (* <- lang_en;; *);
=> nrel_note:
    [Стандартная библиотека — набор модулей и функций, поставляемый вместе с реализацией языка программирования и доступный любой программе без установки дополнительных компонентов.]
    (* <- lang_ru;; *);
=> nrel_explanation:
    [Состав стандартной библиотеки во многом определяет удобство языка: чем она полнее, тем реже приходится подключать сторонние компоненты.]
    (* <- lang_ru;; *);
