            (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Организация-разработчик программного обеспечения — организация, осуществляющая разработку и сопровождение программного обеспечения, в том числе языков программирования и их реализаций.]
                    (* <- lang_ru;; *);;
            *);;
        <= nrel_using_constants: {
            concept_software_development_organization
        };;
