concept_procedural_programming_language
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [процедурный язык программирования]
    (* <- lang_ru;; *);
    [procedural programming language]
    (* <- lang_en;; *);
=> nrel_note:
    [Процедурный язык программирования — язык, в котором программа представляется последовательностью операторов и вызовов процедур, изменяющих состояние памяти.]
    (* <- lang_ru;; *);
=> nrel_explanation:
    [Процедурный подход исторически первым позволил разбивать программу на самостоятельные части и повторно использовать написанный код.]
    (* <- lang_ru;; *);
