concept_logic_programming_language
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [логический язык программирования]
    (* <- lang_ru;; *);
    [logic programming language]
    (* <- lang_en;; *);
=> nrel_note:
    [Логический язык программирования — язык, в котором программа задаётся набором фактов и правил, а вычисление сводится к логическому выводу на них.]
    (* <- lang_ru;; *);
=> nrel_explanation:
    [Программист описывает, что известно и что требуется получить, а порядок вычислений определяет механизм логического вывода самой системы.]
    (* <- lang_ru;; *);
