/* Класс сообщений об авторе языка программирования.
   Содержимое nrel_wit_ai_idtf задано согласно спецификации класса
   сообщений; классификация выполняется логическими правилами
   множества concept_classify_message_rule_priority_1. */

concept_message_about_author
<- sc_node_class;
<- concept_intent_possible_class;
=> nrel_main_idtf:
    [сообщение об авторе языка программирования]
    (* <- lang_ru;; *);
    [message about programming language author]
    (* <- lang_en;; *);
=> nrel_wit_ai_idtf:
    [about_author];
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (сообщение об авторе языка программирования)]
            (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Сообщение об авторе языка программирования - атомарное сообщение, содержащее язык программирования, автора которого требуется найти.]
                    (* <- lang_ru;; *);;
            *);;
        <= nrel_using_constants: {
            concept_atomic_message;
            concept_programming_language;
            concept_programming_language_developer
        };;
    *);;

/* Добавление класса во множество распознаваемых классов цели */
concept_intent_possible_class
-> concept_message_about_author;;
