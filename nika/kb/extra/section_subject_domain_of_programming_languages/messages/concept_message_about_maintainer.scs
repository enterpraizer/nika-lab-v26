/* Класс сообщений ЛР3: вопрос о свойстве «сопровождающая организация» языка программирования.
   Сообщение попадает в класс по логическому правилу классификации
   (множество concept_classify_message_rule_priority_1). */

concept_message_about_maintainer
<- sc_node_class;
<- concept_intent_possible_class;
=> nrel_main_idtf:
    [сообщение об организации, сопровождающей язык программирования]
    (* <- lang_ru;; *);
    [message about programming language maintainer]
    (* <- lang_en;; *);
=> nrel_wit_ai_idtf:
    [about_maintainer];
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (сообщение об организации, сопровождающей язык программирования)]
            (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Сообщение об организации, сопровождающей язык программирования - атомарное сообщение, содержащее язык программирования, сопровождающую организацию которого требуется найти.]
                    (* <- lang_ru;; *);;
            *);;
        <= nrel_using_constants: {
            concept_atomic_message;
            concept_programming_language;
            concept_software_development_organization
        };;
    *);;
