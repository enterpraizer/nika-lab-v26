/* Отношение введено агентом рейтинга TIOBE (ЛР4). Дуги создаёт агент. */

nrel_tiobe_rating_entry
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[запись рейтинга TIOBE*]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[TIOBE index entry*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_programming_language;
=> nrel_second_domain: concept_tiobe_rating_entry;
=> nrel_definitional_domain:
	...
	(*
	<= nrel_combination:
		{
			concept_programming_language;
			concept_tiobe_rating_entry
		};;
	*);
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (запись рейтинга TIOBE*)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Запись рейтинга TIOBE* - бинарное ориентированное отношение, связывающее язык программирования с записью о его положении в рейтинге TIOBE.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_programming_language;
			concept_tiobe_rating_entry
		};;
	*);;
