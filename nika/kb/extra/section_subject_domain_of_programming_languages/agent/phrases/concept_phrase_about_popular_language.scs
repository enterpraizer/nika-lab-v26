/* Класс фраз ответа (ЛР4). Сами фразы и образец — в agent/phrases/examples/concept_phrase_about_popular_language.scs */

concept_phrase_about_popular_language
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о популярном языке программирования]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about a popular programming language]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase;
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (фраза о популярном языке программирования)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Фраза о популярном языке программирования - фраза, сообщающая, что указанный язык программирования входит в первую десятку рейтинга TIOBE, и его место.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_phrase;
			concept_programming_language;
			concept_tiobe_rating_entry;
			nrel_tiobe_rating_entry
		};;
	*);;
