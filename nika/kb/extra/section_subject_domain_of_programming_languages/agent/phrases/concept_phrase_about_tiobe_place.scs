/* Класс фраз ответа (ЛР4). Сами фразы и образец — в agent/phrases/examples/concept_phrase_about_tiobe_place.scs */

concept_phrase_about_tiobe_place
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о месте языка программирования в рейтинге TIOBE]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about the TIOBE index position of a programming language]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase;
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (фраза о месте языка программирования в рейтинге TIOBE)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Фраза о месте языка программирования в рейтинге TIOBE - фраза, сообщающая место указанного языка программирования в рейтинге TIOBE по сведениям, погружённым агентом рейтинга.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_phrase;
			concept_programming_language;
			concept_tiobe_rating_entry;
			nrel_tiobe_rating_entry
		};;
	*);;
