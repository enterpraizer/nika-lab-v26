/* Класс фраз ответа (ЛР4). Сами фразы и образец — в agent/phrases/examples/concept_phrase_about_language_outside_tiobe.scs */

concept_phrase_about_language_outside_tiobe
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о языке программирования вне рейтинга TIOBE]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about a programming language outside the TIOBE index]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase;
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (фраза о языке программирования вне рейтинга TIOBE)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Фраза о языке программирования вне рейтинга TIOBE - фраза, сообщающая, что указанного языка программирования нет среди первых 50 языков рейтинга TIOBE.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_phrase;
			concept_programming_language;
			concept_tiobe_rating_entry;
			nrel_tiobe_rating_entry
		};;
	*);;
