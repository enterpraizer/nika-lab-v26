=> nrel_main_idtf:
    [место работы разработчика*]
    (* <- lang_ru;; *);
    [developer organization*]
    (* <- lang_en;; *);
=> nrel_note:
    [Связывает разработчика языка программирования с организацией, в которой велась разработка языка.]
    (* <- lang_ru;; *);
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_first_domain: concept_programming_language_developer;
=> nrel_second_domain: concept_software_development_organization;
=> nrel_definitional_domain:
    ...
    (*
    <= nrel_combination:
