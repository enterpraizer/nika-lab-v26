    (* <- lang_ru;; *);
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_first_domain: concept_programming_language;
=> nrel_second_domain: concept_language_standard;
=> nrel_definitional_domain:
    ...
    (*
    <= nrel_combination:
