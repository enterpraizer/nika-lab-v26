/* Класс фраз ответа (ЛР3). Сами фразы и образец — в phrases/examples/concept_phrase_about_implementation.scs */

concept_phrase_about_implementation
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о реализации языка программирования]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about programming language implementation]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase;
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (фраза о реализации языка программирования)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Фраза о реализации языка программирования - фраза, сообщающая, какой реализацией пользуется указанный язык программирования.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_phrase;
			concept_programming_language;
			concept_programming_language_implementation;
			nrel_language_implementation
		};;
	*);;
