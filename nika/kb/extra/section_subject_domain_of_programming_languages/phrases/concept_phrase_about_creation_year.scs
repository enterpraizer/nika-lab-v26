/* Класс фраз ответа (ЛР3). Сами фразы и образец — в phrases/examples/concept_phrase_about_creation_year.scs */

concept_phrase_about_creation_year
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о годе создания языка программирования]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about programming language creation year]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase;
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (фраза о годе создания языка программирования)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Фраза о годе создания языка программирования - фраза, сообщающая, в каком году появился указанный язык программирования.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_phrase;
			concept_programming_language;
			concept_calendar_year;
			nrel_creation_year
		};;
	*);;
